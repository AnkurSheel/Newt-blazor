<NavLink href="@Link"
         title="@(IsCollapsed ? Title : null)"
         class="@($"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-foreground-muted hover:text-foreground hover:bg-background-interactive/60 transition {(IsCollapsed ? "justify-center px-0" : "")}")"
         ActiveClass="bg-background-interactive/90 text-brand-accent font-semibold shadow-inner border border-outline-strong/50"
         Match="@Match">
    @SvgContent
    @if (!IsCollapsed)
    {
        <span class="truncate">@Title</span>
    }
</NavLink>
@using NetWorthTracker.Core.Features.FinancialSummary
@using NetWorthTracker.Services.Api.Features.FinancialSummary
@inject IFinancialSummaryService FinancialSummaryService

<section class="grid grid-cols-1 sm:grid-cols-3 gap-4">

    <FinancialCardSummary SummaryType="SummaryType.ASSET"
                          Amount="_monthlySummary.TotalAssets"
                          AbsoluteChange="_monthlyNetworthChange.AbsoluteAssetChange"
                          PercentageChange="_monthlyNetworthChange.AssetPercentChange"/>

    <FinancialCardSummary SummaryType="SummaryType.LIABILITY"
                          Amount="_monthlySummary.TotalLiabilities"
                          AbsoluteChange="_monthlyNetworthChange.AbsoluteLiabilityChange"
                          PercentageChange="_monthlyNetworthChange.LiabilityPercentChange"/>

    <FinancialCardSummary SummaryType="SummaryType.NETWORTH"
                          Amount="_monthlySummary.NetWorth"
                          AbsoluteChange="_monthlyNetworthChange.AbsoluteNetWorthChange"
                          PercentageChange="_monthlyNetworthChange.NetWorthPercentChange"/>

</section>

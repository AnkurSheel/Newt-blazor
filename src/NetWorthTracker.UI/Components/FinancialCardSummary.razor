<div class="p-5 rounded-xl border border-slate-800 bg-slate-950/60 shadow-lg flex flex-col justify-between">
    <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">@Title</span>
        <span
            class="px-2 py-0.5 rounded-md text-xs font-semibold @CssColor @BadgeBorderCssColors">
            @BadgeText
        </span>
    </div>
    <div class="mt-3">
        <span class="text-2xl sm:text-3xl font-mono font-bold @CssColor ">
            @Amount.ToString("C2")
        </span>
    </div>
</div>
<div class="p-5 rounded-xl border shadow-lg flex flex-col justify-between @GetCardCssClass()">
    <div class="text-xs font-medium uppercase tracking-wider">@GetTitle()</div>

    <div class="mt-3 flex flex-col items-start gap-2">
        <span class="text-2xl sm:text-3xl font-mono font-bold text-slate-100 tracking-tight">
            @GetFormattedAmount(Amount)
        </span>

        <div class="flex items-center gap-5 text-xs font-semibold ">
            <Pill CssClasses="@GetChangeCssClass()">
                @GetFormattedPercentageChange()
            </Pill>
            <Pill CssClasses="@GetChangeCssClass()">
                @GetFormattedAbsoluteChange(AbsoluteChange)
            </Pill>
        </div>
    </div>
</div>
@using NetWorthTracker.UI.Components.Icons
<nav
    class="@($"flex flex-col gap-1.5 p-3 min-h-screen bg-slate-950 border-r border-slate-800 text-slate-300 select-none transition-all duration-300 {(isCollapsed ? "w-16" : "w-60")}")">

    <!-- Header with logo & collapse toggle -->
    <div class="flex items-center justify-between px-2 py-3 mb-3 border-b border-slate-800/80">
        <div class="flex items-center gap-2.5 overflow-hidden">
            <div
                class="h-8 w-8 shrink-0 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-indigo-500/20">
                NW
            </div>
            @if (!isCollapsed)
            {
                <div class="truncate">
                    <span class="font-bold text-sm tracking-wide text-white block">Net Worth</span>
                    <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wider block">Tracker</span>
                </div>
            }
        </div>

        <button @onclick="ToggleNav"
                type="button"
                aria-label="Toggle navigation"
                class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/80 transition focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="@($"h-4 w-4 transform transition-transform duration-300 {(isCollapsed ? "rotate-180" : "")}")"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
            </svg>
        </button>
    </div>

    <!-- Navigation Links -->
    <CustomNavLink IsCollapsed="@isCollapsed" Link="/dashboard" Title="Dashboard" Match="NavLinkMatch.Prefix">
        <SvgContent>
            <DashboardIcon/>
        </SvgContent>
    </CustomNavLink>
    <CustomNavLink IsCollapsed="@isCollapsed" Link="/accounts" Title="Accounts">
        <SvgContent>
            <AccountIcon/>
        </SvgContent>
    </CustomNavLink>
</nav>
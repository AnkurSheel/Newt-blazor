@inherits LayoutComponentBase

<div class="flex min-h-screen w-full bg-background-page text-foreground e-dark-mode">
    <NavMenu/>
    <div class="flex-1 min-w-0">
        <CascadingValue Value="@_selectedDate">
            <CascadingValue Name="SelectMonth" Value="@_selectMonth">
                <main class="min-h-screen w-full bg-background-page text-foreground font-sans">
                    <AppErrorBoundary>
                        @Body
                    </AppErrorBoundary>
                </main>
            </CascadingValue>
        </CascadingValue>
    </div>
</div>

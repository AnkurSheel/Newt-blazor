@page "/accounts"
@using NetWorthTracker.Core.Features.Account
@using NetWorthTracker.Services.Api.Features.Account
@using NetWorthTracker.UI.Feature.MonthlyBalance

@inject IAccountService AccountService

<div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 py-1">
        <!-- Left Group: Filter Tabs & Count Badge -->
        <div class="flex items-center gap-3 flex-wrap">
            <div
                class="inline-flex p-1 bg-slate-950 rounded-xl border border-slate-800/80 text-xs font-medium shadow-inner">
                @foreach (var status in new[] { "Active", "Closed", "All" })
                {
                    <button @onclick="() => _filterStatus = status"
                            type="button"
                            class="px-3.5 py-1.5 rounded-lg transition-all duration-150 font-medium @(_filterStatus == status ? "bg-slate-800 text-white shadow-sm border border-slate-700/50" : "text-slate-400 hover:text-slate-200 hover:bg-slate-900/50")">
                        @status
                    </button>
                }
            </div>

            <span
                class="text-xs font-medium text-slate-400 bg-slate-900/80 px-2.5 py-1 rounded-full border border-slate-800/80">
                @FilteredAccounts.Count() accounts
            </span>
        </div>

        <!-- Right Group: Primary Action Button -->
        <button @onclick="() => _isOpen = true"
                type="button"
                class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium text-xs sm:text-sm rounded-xl shadow-md shadow-indigo-600/20 hover:shadow-indigo-500/30 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <span>Add Account</span>
        </button>
    </div>

    <!-- Grid Container -->
    <div class="w-full overflow-x-auto rounded-xl border border-slate-800 shadow-2xl bg-slate-950">
        <SfGrid DataSource="@FilteredAccounts" TValue="AccountResponseDTO" AllowPaging="true" AllowSorting="true"
                Width="100%">
            <GridPageSettings PageSize="10" PageSizes="true"></GridPageSettings>
            <GridColumns>

                <!-- Account Name -->
                <GridColumn Field="@nameof(AccountResponseDTO.Name)" HeaderText="Account Name" Width="30%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <div class="flex items-center gap-2 min-w-0">
                                <span
                                    class="truncate @(item.IsClosedOn(SelectedDate) ? "line-through text-slate-500" : "font-medium text-slate-200")"
                                    title="@item.Name">
                                    @item.Name
                                </span>
                            </div>
                        }
                    </Template>
                </GridColumn>

                <!-- Type -->
                <GridColumn Field="@nameof(AccountResponseDTO.Type)" HeaderText="Type" Width="15%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            if (item.Type == AccountType.ASSET)
                            {
                                <span
                                    class="px-2.5 py-1 text-xs font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 rounded-full inline-block">
                                    Asset
                                </span>
                            }
                            else
                            {
                                <span
                                    class="px-2.5 py-1 text-xs font-semibold text-rose-400 bg-rose-950/60 border border-rose-800/50 rounded-full inline-block">
                                    Liability
                                </span>
                            }
                        }
                    </Template>
                </GridColumn>

                <!-- Open Date -->
                <GridColumn Field="@nameof(AccountResponseDTO.OpenDate)" HeaderText="Open Date" Width="18%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <span
                                class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-2 py-1 rounded inline-block">
                                @item.OpenDate.ToString("MMM yyyy")
                            </span>
                        }
                    </Template>
                </GridColumn>

                <!-- Status / Closed Date -->
                <GridColumn Field="@nameof(AccountResponseDTO.ClosedDate)" HeaderText="Status / Closed Date"
                            Width="17%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            if (item.IsClosedOn(SelectedDate))
                            {
                                <span
                                    class="text-xs font-mono text-slate-500 bg-slate-900 border border-slate-800 px-2 py-1 rounded inline-block">
                                    Closed @item.ClosedDate?.ToString("MMM, yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active
                                </span>
                            }
                        }
                    </Template>
                </GridColumn>

                <!-- Latest Balance -->
                <GridColumn Field="@nameof(AccountResponseDTO.LatestBalance)" HeaderText="Latest Balance"
                            TextAlign="TextAlign.Right" Width="20%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <span
                                class="font-mono text-sm font-semibold @(item.Type == AccountType.LIABILITY ? "text-rose-400" : "text-emerald-400")">
                                @(item.LatestBalance.ToString("C2"))
                            </span>
                        }
                    </Template>
                </GridColumn>

                <GridColumn HeaderText="Actions" TextAlign="TextAlign.Center" Width="15%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            if (!item.IsClosedOn(SelectedDate))
                            {
                                <button @onclick="() => OpenAddTransactionModal(item)"
                                        class="px-2.5 py-1 text-xs font-medium text-indigo-400 bg-indigo-950/60 border border-indigo-800/50 hover:bg-indigo-900/80 rounded-md transition inline-flex items-center gap-1">
                                    <span>+ Txn</span>
                                </button>
                            }
                            else
                            {
                                <span class="text-xs text-slate-600 font-medium italic">Closed</span>
                            }
                        }
                    </Template>
                </GridColumn>

            </GridColumns>
        </SfGrid>
    </div>
    <AddAccountModal @bind-IsVisible="@_isOpen" OnAccountSaved="Refresh"/>

    <AddMonthlyBalanceModal @bind-IsVisible="_isTransactionModalOpen"
                            AccountId="@(_selectedAccountForTransaction?.Id ?? 0)"
                            AccountName="@(_selectedAccountForTransaction?.Name ?? string.Empty)"
                            StartingBalance="@(_selectedAccountForTransaction?.LatestBalance ?? 0m)"
                            OnTransactionSaved="Refresh"/>
</div>
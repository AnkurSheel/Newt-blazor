@page "/accounts"
@using NetWorthTracker.Core.Features.Account
@using NetWorthTracker.Services.Api.Features.Account

@inject IAccountService AccountService

<div class="h-screen w-full flex flex-col bg-slate-900 text-slate-100 font-sans overflow-hidden">

    <!-- Top Bar Header -->
    <header class="h-16 border-b border-slate-800 px-8 flex items-center justify-between bg-slate-900/80 backdrop-blur">
        <h1 class="text-xl font-semibold tracking-wide text-white">Net Worth Tracker</h1>
        <button @onclick="@(() => _isOpen = true)"
                class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm rounded-lg shadow transition flex items-center gap-2">
            <span class="text-lg font-bold">+</span> Add Account
        </button>
    </header>
    
    <AddAccountModal @bind-IsVisible="@_isOpen">
    </AddAccountModal>

    <!-- Main Table Container -->
    <main class="flex-1 p-8 overflow-auto">
        <div class="mb-4 flex justify-between items-center">
            <div class="inline-flex p-1 bg-slate-950 rounded-lg border border-slate-800 text-xs font-medium">
                <button @onclick='() => _filterStatus = "Active"'
                        class="px-3 py-1.5 rounded-md transition @(_filterStatus == "Active" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-slate-200")">
                    Active
                </button>
                <button @onclick='() => _filterStatus = "Closed"'
                        class="px-3 py-1.5 rounded-md transition @(_filterStatus == "Closed" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-slate-200")">
                    Closed
                </button>
                <button @onclick='() => _filterStatus = "All"'
                        class="px-3 py-1.5 rounded-md transition @(_filterStatus == "All" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-slate-200")">
                    All
                </button>
            </div>

            <span class="text-xs text-slate-400">
                Showing @FilteredAccounts.Count() accounts
            </span>
        </div>

        <div class="rounded-xl border border-slate-800 overflow-hidden shadow-2xl bg-slate-950">
            <SfGrid DataSource="@FilteredAccounts" TValue="AccountResponseDTO" AllowPaging="true" AllowSorting="true">
                <GridPageSettings PageSize="10" PageSizes="true"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(AccountResponseDTO.Name)" HeaderText="Account Name" Width="220">
                        <Template>
                            @{
                                var item = context as AccountResponseDTO;
                                <div class="flex items-center gap-2">
                                    <span
                                        class="@(item?.ClosedDate != null ? "line-through text-slate-500" : "font-medium text-slate-200")">
                                        @item?.Name
                                    </span>
                                </div>
                            }
                        </Template>
                    </GridColumn>

                    <GridColumn Field="@nameof(AccountResponseDTO.Type)" HeaderText="Type" Width="120">
                        <Template>
                            @{
                                var item = context as AccountResponseDTO;
                                if (item?.Type == AccountType.ASSET)
                                {
                                    <span
                                        class="px-2.5 py-1 text-xs font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 rounded-full">Asset</span>
                                }
                                else
                                {
                                    <span
                                        class="px-2.5 py-1 text-xs font-semibold text-rose-400 bg-rose-950/60 border border-rose-800/50 rounded-full">Liability</span>
                                }
                            }
                        </Template>
                    </GridColumn>

                    <GridColumn Field="@nameof(AccountResponseDTO.ClosedDate)" HeaderText="Status / Closed Date" Width="180">
                        <Template>
                            @{
                                var item = context as AccountResponseDTO;
                                if (item?.ClosedDate != null)
                                {
                                    <span
                                        class="text-xs font-mono text-slate-500 bg-slate-900 border border-slate-800 px-2 py-1 rounded">
                                        Closed @item?.ClosedDate?.ToString("MMM, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Active
                                    </span>
                                }
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </main>
</div>
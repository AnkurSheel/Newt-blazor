@page "/accounts"
@using NetWorthTracker.Core.Features.Account
@using NetWorthTracker.Services.Api.Features.Account

@inject IAccountService AccountService

<div class="min-h-screen w-full flex flex-col bg-slate-900 text-slate-100 font-sans">

    <!-- Top Bar Header -->
    <header
        class="h-16 border-b border-slate-800 px-4 sm:px-8 flex items-center justify-between bg-slate-900/80 backdrop-blur sticky top-0 z-10">
        <h1 class="text-lg sm:text-xl font-semibold tracking-wide text-white truncate">Net Worth Tracker</h1>
        <button @onclick="@(() => _isOpen = true)"
                class="px-3.5 py-1.5 sm:px-4 sm:py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs sm:text-sm rounded-lg shadow transition flex items-center gap-1.5 shrink-0">
            <span class="text-base sm:text-lg font-bold">+</span>
            <span>Add Account</span>
        </button>
    </header>

    <AddAccountModal @bind-IsVisible="@_isOpen"/>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 sm:p-8 overflow-x-hidden space-y-6">

        <!-- Financial Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

            <!-- Total Assets -->
            <div class="p-5 rounded-xl border border-slate-800 bg-slate-950/60 shadow-lg flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Assets</span>
                    <span
                        class="px-2 py-0.5 rounded-md bg-emerald-950/60 border border-emerald-800/40 text-emerald-400 text-xs font-semibold">
                        ▲ Asset
                    </span>
                </div>
                <div class="mt-3">
                    <span class="text-2xl sm:text-3xl font-mono font-bold text-emerald-400">
                        @TotalAssets.ToString("C2")
                    </span>
                </div>
            </div>

            <!-- Total Liabilities -->
            <div class="p-5 rounded-xl border border-slate-800 bg-slate-950/60 shadow-lg flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Liabilities</span>
                    <span
                        class="px-2 py-0.5 rounded-md bg-rose-950/60 border border-rose-800/40 text-rose-400 text-xs font-semibold">
                        ▼ Debt
                    </span>
                </div>
                <div class="mt-3">
                    <span class="text-2xl sm:text-3xl font-mono font-bold text-rose-400">
                        @TotalLiabilities.ToString("C2")
                    </span>
                </div>
            </div>

            <!-- Net Worth -->
            <div class="p-5 rounded-xl border border-slate-800 bg-slate-950/60 shadow-lg flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">Net Worth</span>
                    <span
                        class="px-2 py-0.5 rounded-md bg-indigo-950/60 border border-indigo-800/40 text-indigo-400 text-xs font-semibold">
                        Total
                    </span>
                </div>
                <div class="mt-3">
                    <span
                        class="text-2xl sm:text-3xl font-mono font-bold @(NetWorth >= 0 ? "text-indigo-400" : "text-rose-400")">
                        @NetWorth.ToString("C2")
                    </span>
                </div>
            </div>

        </div>

        <!-- Filter Controls Bar -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div
                class="inline-flex p-1 bg-slate-950 rounded-lg border border-slate-800 text-xs font-medium w-full sm:w-auto justify-stretch">
                <button @onclick='() => _filterStatus = "Active"'
                        class="flex-1 sm:flex-initial px-3 py-1.5 rounded-md transition text-center @(_filterStatus == "Active" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-slate-200")">
                    Active
                </button>
                <button @onclick='() => _filterStatus = "Closed"'
                        class="flex-1 sm:flex-initial px-3 py-1.5 rounded-md transition text-center @(_filterStatus == "Closed" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-slate-200")">
                    Closed
                </button>
                <button @onclick='() => _filterStatus = "All"'
                        class="flex-1 sm:flex-initial px-3 py-1.5 rounded-md transition text-center @(_filterStatus == "All" ? "bg-slate-800 text-white" : "text-slate-400 hover:text-slate-200")">
                    All
                </button>
            </div>

            <span class="text-xs text-slate-400 self-end sm:self-auto">
                Showing @FilteredAccounts.Count() accounts
            </span>
        </div>

        <!-- Grid Container -->
        <div class="w-full overflow-x-auto rounded-xl border border-slate-800 shadow-2xl bg-slate-950">
            <SfGrid DataSource="@FilteredAccounts" TValue="AccountResponseDTO" AllowPaging="true" AllowSorting="true"
                    Width="100%">
                <GridPageSettings PageSize="10" PageSizes="true"></GridPageSettings>
                <GridColumns>

                    <!-- Account Name -->
                    <GridColumn Field="@nameof(AccountResponseDTO.Name)" HeaderText="Account Name" Width="30%">
                        <Template>
                            @{
                                var item = (AccountResponseDTO)context;
                                <div class="flex items-center gap-2 min-w-0">
                                    <span
                                        class="truncate @(item.IsClosed ? "line-through text-slate-500" : "font-medium text-slate-200")"
                                        title="@item?.Name">
                                        @item?.Name
                                    </span>
                                </div>
                            }
                        </Template>
                    </GridColumn>

                    <!-- Type -->
                    <GridColumn Field="@nameof(AccountResponseDTO.Type)" HeaderText="Type" Width="15%">
                        <Template>
                            @{
                                var item = (AccountResponseDTO)context;
                                if (item.Type == AccountType.ASSET)
                                {
                                    <span
                                        class="px-2.5 py-1 text-xs font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 rounded-full inline-block">
                                        Asset
                                    </span>
                                }
                                else
                                {
                                    <span
                                        class="px-2.5 py-1 text-xs font-semibold text-rose-400 bg-rose-950/60 border border-rose-800/50 rounded-full inline-block">
                                        Liability
                                    </span>
                                }
                            }
                        </Template>
                    </GridColumn>

                    <!-- Open Date -->
                    <GridColumn Field="@nameof(AccountResponseDTO.OpenDate)" HeaderText="Open Date" Width="18%">
                        <Template>
                            @{
                                var item = (AccountResponseDTO)context;
                                <span
                                    class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-2 py-1 rounded inline-block">
                                    @item.OpenDate.ToString("MMM yyyy")
                                </span>
                            }
                        </Template>
                    </GridColumn>

                    <!-- Status / Closed Date -->
                    <GridColumn Field="@nameof(AccountResponseDTO.ClosedDate)" HeaderText="Status / Closed Date"
                                Width="17%">
                        <Template>
                            @{
                                var item = (AccountResponseDTO)context;
                                if (item.IsClosed)
                                {
                                    <span
                                        class="text-xs font-mono text-slate-500 bg-slate-900 border border-slate-800 px-2 py-1 rounded inline-block">
                                        Closed @item?.ClosedDate?.ToString("MMM, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active
                                    </span>
                                }
                            }
                        </Template>
                    </GridColumn>

                    <!-- Latest Balance -->
                    <GridColumn Field="@nameof(AccountResponseDTO.LatestBalance)" HeaderText="Latest Balance"
                                TextAlign="TextAlign.Right" Width="20%">
                        <Template>
                            @{
                                var item = (AccountResponseDTO)context;
                                <span
                                    class="font-mono text-sm font-semibold @(item.Type == AccountType.LIABILITY ? "text-rose-400" : "text-emerald-400")">
                                    @(item.LatestBalance.ToString("C2"))
                                </span>
                            }
                        </Template>
                    </GridColumn>

                </GridColumns>
            </SfGrid>
        </div>
    </main>
</div>

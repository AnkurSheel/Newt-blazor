@page "/accounts"
@using NetWorthTracker.Business.Features.Accounts.Api

<div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 py-1">
        <!-- Left Group: Filter Tabs & Count Badge -->
        <div class="flex items-center gap-3 flex-wrap">
            <div
                class="inline-flex p-1 bg-background-panel rounded-xl border border-outline/80 text-xs font-medium shadow-inner">
                @foreach (var status in new[] { "Active", "Closed", "All" })
                {
                    <button @onclick="() => SelectFilterAsync(status)"
                            type="button"
                            class="px-3.5 py-1.5 rounded-lg transition-all duration-150 font-medium @(_filterStatus == status ? "bg-background-interactive text-foreground-inverse shadow-sm border border-outline-strong/50" : "text-foreground-muted hover:text-foreground-secondary hover:bg-background-page/50")">
                        @status
                    </button>
                }
            </div>

            <span
                class="text-xs font-medium text-foreground-muted bg-background-page/80 px-2.5 py-1 rounded-full border border-outline/80">
                @_accounts.Count accounts
            </span>
        </div>

        <!-- Right Group: Primary Action Button -->
        <button @onclick="() => _isOpen = true"
                type="button"
                class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-brand-primary hover:bg-brand-primary-hover active:bg-brand-primary-active text-foreground-inverse font-medium text-xs sm:text-sm rounded-xl shadow-md shadow-brand-primary/20 hover:shadow-brand-primary-hover/30 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-brand-accent shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 stroke-[2.5]" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <span>Add Account</span>
        </button>
    </div>

    <!-- Grid Container -->
    <div class="w-full overflow-x-auto rounded-xl border border-outline shadow-2xl bg-background-panel">
        <SfGrid DataSource="@_accounts" TValue="AccountResponseDTO" AllowPaging="true" AllowSorting="true"
                Width="100%">
            <GridPageSettings PageSize="10" PageSizes="true"></GridPageSettings>
            <GridColumns>

                <!-- Account Name -->
                <GridColumn Field="@nameof(AccountResponseDTO.Name)" HeaderText="Account Name" Width="30%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <div class="flex items-center gap-2 min-w-0">
                                <span
                                    class="truncate @(item.IsClosedOn(SelectedDate) ? "line-through text-foreground-muted" : "font-medium text-foreground-secondary")"
                                    title="@item.Name">
                                    @item.Name
                                </span>
                            </div>
                        }
                    </Template>
                </GridColumn>

                <!-- Type -->
                <GridColumn Field="@nameof(AccountResponseDTO.Type)" HeaderText="Type" Width="15%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            if (item.Type == AccountType.ASSET)
                            {
                                <span
                                    class="px-2.5 py-1 text-xs font-semibold text-financial-positive bg-financial-positive-background/60 border border-financial-positive-outline/50 rounded-full inline-block">
                                    Asset
                                </span>
                            }
                            else
                            {
                                <span
                                    class="px-2.5 py-1 text-xs font-semibold text-account-liability bg-account-liability-background/60 border border-account-liability-outline/50 rounded-full inline-block">
                                    Liability
                                </span>
                            }
                        }
                    </Template>
                </GridColumn>

                <!-- Open Date -->
                <GridColumn Field="@nameof(AccountResponseDTO.OpenDate)" HeaderText="Open Date" Width="18%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <span
                                class="text-xs font-mono text-foreground-muted bg-background-page border border-outline px-2 py-1 rounded inline-block">
                                @item.OpenDate.ToString("MMM yyyy")
                            </span>
                        }
                    </Template>
                </GridColumn>

                <!-- Status / Closed Date -->
                <GridColumn Field="@nameof(AccountResponseDTO.ClosedDate)" HeaderText="Status / Closed Date"
                            Width="17%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            if (item.OpenDate > SelectedDate)
                            {
                                <span
                                    class="text-xs font-mono text-foreground-muted bg-background-page border border-outline px-2 py-1 rounded inline-block">
                                    Not yet open
                                </span>
                            }
                            else if (item.IsClosedOn(SelectedDate))
                            {
                                <span
                                    class="text-xs font-mono text-foreground-muted bg-background-page border border-outline px-2 py-1 rounded inline-block">
                                    Closed @item.ClosedDate?.ToString("MMM, yyyy")
                                </span>
                            }
                            else
                            {
                                <span
                                    class="inline-flex items-center gap-1.5 text-xs text-financial-positive font-medium">
                                    <span class="h-1.5 w-1.5 rounded-full bg-financial-positive animate-pulse"></span> Active
                                </span>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
    <AddAccountModal @bind-IsVisible="@_isOpen" OnAccountSaved="Refresh"/>
</div>
@using NetWorthTracker.Business.Features.Accounts.Api
@using Syncfusion.Blazor.Popups
@inject IAccountService AccountService;

<!-- Centered Modal Overlay Window Component Layout -->
<SfDialog Width="460px"
          IsModal="true"
          Visible="@IsVisible"
          VisibleChanged="@OnVisibleChanged"
          ShowCloseIcon="false"
          EnableResize="false"
          AllowDragging="false"
          CssClass="bg-background-page border border-outline rounded-xl shadow-2xl overflow-hidden p-0">
    <DialogTemplates>
        <Content>
            <!-- Custom Internal View Wrapper Layout -->
            <div class="flex flex-col justify-between p-6 bg-background-page text-foreground min-h-100">
                <div>
                    <!-- Header Box Section Layout -->
                    <div class="flex items-center justify-between pb-6 border-b border-outline">
                        <h3 class="text-lg font-semibold text-foreground-inverse">Add New Account</h3>
                        <button @onclick="CloseModal" class="text-foreground-muted hover:text-foreground-inverse text-xl transition">✕
                        </button>
                    </div>

                    <!-- Main Form Fields Stack -->
                    <div class="mt-6 space-y-5">


                        <EnumDropDownList TEnum="AccountType"
                                          Label="Account Type"
                                          Placeholder="Select Account Type"
                                          Exclude="[AccountType.DONOTUSE]"
                                          @bind-Value="@_newAccountType"/>

                        <!-- Account Name Field Group Layout -->
                        <div>
                            <label for="account-name"
                                   class="block text-xs font-semibold text-foreground-muted uppercase tracking-wider mb-2">Account
                                Name</label>
                            <SfTextBox ID="account-name" @bind-Value="_newAccountName"
                                       Placeholder="e.g. Primary Checking"
                                       @bind-Value:after="ClearAccountNameError"
                                       CssClass="e-dark-mode"/>
                            @if (_accountNameError is not null)
                            {
                                <p role="alert" class="mt-1 text-sm text-feedback-error">@_accountNameError</p>
                            }
                        </div>

                        <MonthYearPicker Label="Open Date" @bind-Value="@_openDate"/>

                        <!-- Mark as Closed Toggle Option Layout Panel -->
                        <div class="pt-2 border-t border-outline">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox"
                                       checked="@_isAccountClosed"
                                       @onchange="ToggleClosedState"
                                       class="rounded border-outline-strong bg-background-panel text-brand-primary focus:ring-0 w-4 h-4"/>
                                <span class="text-xs font-semibold text-foreground-tertiary">This account is closed</span>
                            </label>

                            @if (_isAccountClosed)
                            {
                                <MonthYearPicker Label="Closed Date" @bind-Value="@_closedDate"/>
                            }
                        </div>

                    </div>
                </div>

                <!-- Footer Call to Action Panel Layout Elements -->
                <div class="pt-6 mt-6 border-t border-outline flex items-center justify-end gap-3">
                    <button @onclick="CloseModal"
                            class="px-4 py-2 text-sm font-medium text-foreground-muted hover:text-foreground-inverse transition">Cancel
                    </button>
                    <button @onclick="SaveAccount" disabled="@_isSaving"
                            class="px-5 py-2 text-sm font-medium bg-brand-primary hover:bg-brand-primary-hover text-foreground-inverse rounded-lg shadow transition">
                        Save Account
                    </button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>
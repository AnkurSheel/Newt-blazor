@using NetWorthTracker.Business.Features.MonthlyBalances.Api
@inject IMonthlyBalanceService MonthlyBalanceService

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-background-overlay/80 backdrop-blur-sm p-4">
        <div class="w-full max-w-md rounded-xl border border-outline bg-background-page p-6 shadow-2xl space-y-5">

            <!-- Header -->
            <div class="flex items-center justify-between border-b border-outline pb-3">
                <h3 class="text-lg font-semibold text-foreground-inverse">Add Transaction</h3>
                <button @onclick="CloseModal" class="text-foreground-muted hover:text-foreground-inverse transition">✕</button>
            </div>

            <!-- Body / Inputs -->
            <div class="space-y-4">
                <div>
                    <label
                        class="block text-xs font-medium text-foreground-muted uppercase tracking-wider mb-1">Account</label>
                    <p class="text-sm font-semibold text-foreground-secondary bg-background-panel border border-outline px-3 py-2 rounded-lg">
                        @AccountName
                    </p>
                </div>

                <!-- Month Picker (Restricted to max = current month) -->
                <MonthYearPicker Label="Transaction Date" @bind-Value="_transactionDate"></MonthYearPicker>

                <!-- Balance Input -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-medium text-foreground-muted uppercase tracking-wider">Balance
                            Amount</label>
                        <button type="button"
                                @onclick="CopyBalanceFromLastMonthAsync"
                                class="text-xs font-medium text-brand-accent hover:text-brand-accent-muted transition flex items-center gap-1 cursor-pointer">
                            <CopyIcon/>
                            <span>Copy balance from last month</span>
                        </button>
                    </div>
                    <input type="number" step="0.01" @bind="_balance"
                           class="w-full bg-background-panel border border-outline text-foreground font-mono rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-primary-hover"/>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline">
                <button @onclick="CloseModal"
                        class="px-4 py-2 text-xs font-medium text-foreground-muted hover:text-foreground-inverse transition">
                    Cancel
                </button>
                <button @onclick="SaveMonthlyBalance"
                        class="px-4 py-2 bg-brand-primary hover:bg-brand-primary-hover text-foreground-inverse font-medium text-xs rounded-lg shadow transition">
                    Save Transaction
                </button>
            </div>

        </div>
    </div>
}

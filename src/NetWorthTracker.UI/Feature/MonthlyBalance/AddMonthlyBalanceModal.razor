@using NetWorthTracker.Services.Api.Features.MonthlyBalance
@inject IMonthlyBalanceService MonthlyBalanceService

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
        <div class="w-full max-w-md rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-2xl space-y-5">

            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="text-lg font-semibold text-white">Add Transaction</h3>
                <button @onclick="CloseModal" class="text-slate-400 hover:text-white transition">✕</button>
            </div>

            <!-- Body / Inputs -->
            <div class="space-y-4">
                <div>
                    <label
                        class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Account</label>
                    <p class="text-sm font-semibold text-slate-200 bg-slate-950 border border-slate-800 px-3 py-2 rounded-lg">
                        @AccountName
                    </p>
                </div>

                <!-- Month Picker (Restricted to max = current month) -->
                <MonthYearPicker Label="Transaction Date" @bind-Value="_transactionDate"></MonthYearPicker>

                <!-- Balance Input -->
                <div>
                    <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Balance
                        Amount</label>
                    <input type="number" step="0.01" @bind="_balance"
                           class="w-full bg-slate-950 border border-slate-800 text-slate-100 font-mono rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500"/>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
                <button @onclick="CloseModal"
                        class="px-4 py-2 text-xs font-medium text-slate-400 hover:text-white transition">
                    Cancel
                </button>
                <button @onclick="SaveMonthlyBalance"
                        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs rounded-lg shadow transition">
                    Save Transaction
                </button>
            </div>

        </div>
    </div>
}

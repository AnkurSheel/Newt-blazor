@page "/monthly-check-in"
@using NetWorthTracker.Business.Features.Accounts.Api
@using NetWorthTracker.UI.Feature.Account

@inject IAccountService AccountService

<PageHeader Title="Dashboard">
    <MonthNavigation/>
</PageHeader>
<div class="p-4 sm:p-8 space-y-6">
    <AppErrorBoundary>
        <FinancialSummaryContainer/>
    </AppErrorBoundary>
    @if (!Accounts.Any())
    {
        <section class="rounded-xl border border-outline bg-background-panel p-6 text-center">
            <p class="text-sm text-foreground-muted">There are no active accounts for this month.</p>
            <a href="/accounts" class="mt-3 inline-block text-sm text-brand-accent">Go to Accounts</a>
        </section>
    }
    else
    {
        <div class="w-full overflow-x-auto rounded-xl border border-outline shadow-2xl bg-background-panel">
            <SfGrid DataSource="@Accounts" TValue="AccountResponseDTO" AllowPaging="true" AllowSorting="true"
                    Width="100%">
                <GridPageSettings PageSize="10" PageSizes="true"></GridPageSettings>
                <GridColumns>

                <!-- Account Name -->
                <GridColumn Field="@nameof(AccountResponseDTO.Name)" HeaderText="Account Name" Width="30%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <AccountName Account="item" SelectedDate="SelectedDate" />
                        }
                    </Template>
                </GridColumn>

                <!-- Type -->
                <GridColumn Field="@nameof(AccountResponseDTO.Type)" HeaderText="Type" Width="15%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <AccountTypeBadge Type="item.Type" />
                        }
                    </Template>
                </GridColumn>

                <!-- Balance -->
                <GridColumn Field="@nameof(AccountResponseDTO.BalanceOnDate)" HeaderText="Balance"
                            TextAlign="TextAlign.Right" Width="20%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            if (item.BalanceOnDate.HasValue)
                            {
                                <span
                                    class="font-mono text-sm font-semibold @(item.Type == AccountType.LIABILITY ? "text-account-liability" : "text-financial-positive")">
                                    @(item.BalanceOnDate.Value.ToString("C2"))
                                </span>
                            }
                            else
                            {
                                <span class="font-mono text-xs text-foreground-muted italic">No Data</span>
                            }
                        }
                    </Template>
                </GridColumn>

                <GridColumn HeaderText="Actions" TextAlign="TextAlign.Center" Width="15%">
                    <Template>
                        @{
                            var item = (AccountResponseDTO)context;
                            <button @onclick="() => OpenAddTransactionModal(item)"
                                    disabled="@item.BalanceOnDate.HasValue"
                                    title="@(item.BalanceOnDate.HasValue ? $"Transaction already recorded for {SelectedDate:MMM yyyy}" : "Add transaction")"
                                    class="px-2.5 py-1 text-xs font-medium rounded-md transition inline-flex items-center gap-1 text-brand-accent bg-brand-background/60 border border-brand-outline/50 hover:bg-brand-background-hover/80 cursor-pointer disabled:bg-background-page disabled:border-outline disabled:text-foreground-disabled disabled:cursor-not-allowed disabled:opacity-50">
                                <span>+ Txn</span>
                            </button>
                        }
                    </Template>
                </GridColumn>

                </GridColumns>
            </SfGrid>
        </div>
    }

    <AddMonthlyBalanceModal @bind-IsVisible="_isTransactionModalOpen"
                            AccountId="@(_selectedAccountForTransaction?.Id ?? 0)"
                            AccountName="@(_selectedAccountForTransaction?.Name ?? string.Empty)"
                            StartingBalance="@(_selectedAccountForTransaction?.BalanceOnDate ?? 0m)"
                            OnTransactionSaved="Refresh"/>
</div>
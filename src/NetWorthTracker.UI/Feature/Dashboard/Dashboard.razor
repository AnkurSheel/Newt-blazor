@page "/dashboard"
@using Syncfusion.Blazor.Charts

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <Trends Title="Year-Over-Year (YoY) Net Worth Trends"
            PercentChangeData="GetYoyPercentChangeData()"
            AbsoluteChangeData="GetYoyAbsoluteChangeData()"
            CumulativeData="GetYoyCumulativeData()"
            IntervalType="IntervalType.Years"
            LabelFormat="yyyy"
            ShowMarkers="true">
    </Trends>
    <Trends Title="Month-Over-Month (MoM) Net Worth Trends"
            PercentChangeData="GetMomPercentChangeData()"
            AbsoluteChangeData="GetMomAbsoluteChangeData()"
            CumulativeData="GetMomCumulativeData()"
            IntervalType="IntervalType.Auto"
            LabelFormat="MMM yyyy">
    </Trends>
</div>

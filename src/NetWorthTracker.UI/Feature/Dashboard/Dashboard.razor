@page "/dashboard"

<div class="min-h-screen w-full flex flex-col bg-slate-900 text-slate-100 font-sans">

    <!-- Top Bar Header -->
    <header
        class="h-16 border-b border-slate-800 px-4 sm:px-8 flex items-center justify-between bg-slate-900/80 backdrop-blur sticky top-0 z-10">
        <h1 class="text-lg sm:text-xl font-semibold tracking-wide text-white truncate">Dashboard</h1>

        <div class="flex items-center gap-3">
            <!-- Custom Syncfusion Month/Year Picker -->
            <div class="w-48 sm:w-56">
                <MonthYearPicker Value="@_selectedDate"
                                 NonNullableValueChanged="OnDateChanged"
                                 Label=""/>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 sm:p-8 overflow-x-hidden space-y-6">

        <FinancialSummaryContainer SelectedDate="@_selectedDate"/>

    </main>
</div>
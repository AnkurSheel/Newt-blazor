@using NetWorthTracker.UI.Components.Charts
<section class="flex flex-col gap-3">
    <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        <h2 class="text-xs font-bold tracking-wider text-slate-400 uppercase">@Title</h2>
    </div>
    <div class="grid grid-rows-1 md:grid-rows-3 gap-4">
        <CumulativeAreaChart Title="Cumulative $ Change"
                             Format="c"
                             Data="CumulativeData"
                             IntervalType="IntervalType"
                             LabelFormat="@LabelFormat"
                             ShowMarkers="ShowMarkers"/>
        <ChangeBarChart Title="% Change"
                        Format="p"
                        Data="PercentChangeData"
                        IntervalType="IntervalType"
                        LabelFormat="@LabelFormat"/>
        <ChangeBarChart Title="Absolute $ Change"
                        Format="c"
                        Data="AbsoluteChangeData"
                        IntervalType="IntervalType"
                        LabelFormat="@LabelFormat"/>
    </div>
</section>